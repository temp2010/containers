# Volumenes y datos (EXCLUIR)
volumes/
data/
adguardhome/
dhcp/
filebrowser/
heimdall/
jellyfin/
homeassistant/
metube/
portainer/
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/
*.out

# Temporales
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Ambiente sensible
.env
.env.local
.env.*.local
GIT-INFO.txt
*.save

# Docker (pero permitir docker-compose.yml)
.docker/
.dockerignore

# Otros
node_modules/
.claude/

# backup: excluir archivos de respaldo pero permitir documentación importante
backup/*
!backup/REGLAS-VPN-BLOQUEO.txt
!backup/INSTRUCCIONES.txt
!backup/restore-iptables.sh

# openclaw: excluir subdirectorios grandes (incluir solo archivos esenciales via reglas específicas más adelante)
openclaw/*
!openclaw/docker-compose.yml
!openclaw/Dockerfile
!openclaw/Dockerfile.*
!openclaw/.dockerignore
!openclaw/docker-setup.sh
!openclaw/setup-podman.sh
!openclaw/.env.example

# Archivos de compilación
dist/
build/
*.o
*.a
*.so

# IDE
.vscode/
.idea/
*.swp
*.iml

# Sistema
.AppleDouble
.LSOverride

# PERMITIR docker-compose files en subcarpetas
!*/docker-compose.yml
!*/docker-compose.yaml

# PERMITIR archivos necesarios para construcción personalizada
!*/Dockerfile
!*/Dockerfile.*
!*/entrypoint.sh
!*/install.sh
!*.env.example

# PERMITIR archivos de configuración críticos
!*/.dockerignore
!*/docker-setup.sh
!*/setup-podman.sh
!*/config/.gitkeep

