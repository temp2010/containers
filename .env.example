# Configuración de ejemplo para containers
# Copiar a .env y completar con valores reales

# General
COMPOSE_PROJECT_NAME=containers

# Redes
SUBNET_DOCKER=192.168.85.0/24
SUBNET_LOCAL=192.168.83.0/24

# Puertos
ADGUARD_WEB_PORT=3080
ADGUARD_DNS_PORT=53
PORTAINER_PORT=9000
JELLYFIN_PORT=8096

# Credenciales (cambiar en producción)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=database

# Directorios
DATA_DIR=/mnt/data
BACKUP_DIR=/mnt/backup

# Timezone
TZ=America/Bogota

# Cloudflare (si usas cloudflared)
CLOUDFLARE_TOKEN=tu_token_aqui

# API Keys (si aplica)
PLEX_CLAIM=

# ==========================================
# PROMETHEUS - Monitoreo de métricas
# ==========================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# ==========================================
# GRAFANA - Visualización de dashboards
# ==========================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com
GRAFANA_SMTP_PORT=587
GRAFANA_SMTP_USER=your_email@gmail.com
GRAFANA_SMTP_PASSWORD=your_app_password

# ==========================================
# LOKI - Agregación de logs
# ==========================================
LOKI_PORT=3100

# ==========================================
# RESTIC - Backups automáticos
# ==========================================
# Ruta del repositorio Restic (local o remoto)
RESTIC_REPOSITORY=/mnt/backup/restic-repo
# Contraseña fuerte para el repositorio
RESTIC_PASSWORD=changeme_strong_password
# Ruta base de backups
RESTIC_BACKUP_PATH=/mnt/backup
# Rutas a respaldar (separadas por comas)
BACKUP_PATHS=/volumes
# Rutas a excluir
BACKUP_EXCLUDE=

# Política de retención (en días)
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12

# Backups de bases de datos
BACKUP_POSTGRES=false
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

BACKUP_MONGODB=false
MONGODB_HOST=mongodb
MONGODB_USER=root
MONGODB_PASSWORD=

# AWS S3 (opcional - para backups en la nube)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Cron schedule para backups automáticos (formato cron)
# Ejemplo: "0 2 * * *" = diariamente a las 2 AM
BACKUP_SCHEDULE=0 2 * * *

# ==========================================
# Configuración General
# ==========================================
ENVIRONMENT=production
DOMAIN=example.com
